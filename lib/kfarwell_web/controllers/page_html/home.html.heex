<div id="screen">
  <div class="window" id="kfarwell-window" data-anchored>
    <div class="title-bar">
      <div class="title-bar-text">kfarwell</div>
      <div class="title-bar-controls">
        <button id="minimize" aria-label="Minimize"></button>
        <button id="maximize" aria-label="Maximize"></button>
        <button id="close" aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body">
      <div id="header">
        <div class="field-border">
          <img id="me" src={~p"/kyle.png"} alt="Kyle" width="128" height="128" />
        </div>
        <div>
          <h1>Kyle Farwell</h1>
          <p>Lead Developer @ Flirtual</p>
        </div>
      </div>

      <h2>who am I</h2>
      <ul>
        <li>
          I'm building <a href="https://flirtual.com/" target="_blank"><img
              src={~p"/icons/flirtual.ico"}
              class="favicon"
            />Flirtual</a>, the first dating app for VR
        </li>
        <li>
          sometimes I make video games with
          <a href="https://gelatolabs.xyz/" target="_blank">
            <img src={~p"/icons/gelatolabs.ico"} class="favicon" />Gelato&nbsp;Labs
          </a>
        </li>
        <li>interests: social vr, music, foss, unix, project diva, mahjong</li>
      </ul>

      <h2>stalk me</h2>
      <p>if you are so inclined</p>
      <ul>
        <li>
          <strong>email:</strong>
          <a href="mailto:m@kfarwell.org" target="_blank">m@kfarwell.org</a>
        </li>
        <li>
          <strong>github:</strong>
          <a href="https://github.com/kfarwell" target="_blank">kfarwell</a>
        </li>
        <li>
          <strong>discord:</strong>
          <a href="https://discordapp.com/users/439941042863603723" target="_blank">kfarwell</a>
        </li>
        <li>
          <strong>x:</strong> <a href="https://x.com/notkfarwell" target="_blank">notkfarwell</a>
        </li>
      </ul>

      <div id="testimonials">
        <h2>testimonials</h2>
        <ul>
          <li>"TECH GENIS" -Algoma University</li>
          <li>"you're well on your way to becoming a super user" -Keefer</li>
          <li>"kfarwell is the best dev ever" -Kritaka</li>
          <li>
            "kyle has anyone ever told you play a decisive role in the global configuration file /etc" -Markov chain
          </li>
          <li>"u want me to pay u for 99$ for premium of this SKid line of code?" -Simon</li>
          <li>"Kyle Farewell" -The Press</li>
        </ul>
      </div>

      <div id="friends">
        <h2>friends</h2>
        <p>some cool people you should go admire or hire or star on github or something</p>
        <ul style="column-width: 8em">
          <li>
            <a href="https://alicedaltonsound.neocities.org" target="_blank">Alice&nbsp;Dalton</a>
          </li>
          <li><a href="https://x.com/existony" target="_blank">Anthony&nbsp;Tan</a></li>
          <li><a href="https://ariesclark.com/" target="_blank">Aries&nbsp;Clark</a></li>
          <li>
            <a href="https://www.twitch.tv/fuughoul" target="_blank">FuuGhoul</a>&nbsp;&lt;3
          </li>
          <li><a href="https://www.twitch.tv/gelatosquid" target="_blank">GelatoSquid</a></li>
          <li><a href="https://jaredkelly.ca/" target="_blank">Jared&nbsp;Kelly</a></li>
          <li><a href="https://x.com/KRastyr" target="_blank">Katten</a></li>
          <li><a href="https://krourke.org/" target="_blank">Keefer&nbsp;Rourke</a></li>
          <li><a href="https://sillylaird.ca/" target="_blank">Laird&nbsp;Lonergan</a></li>
          <li><a href="https://www.twitch.tv/loveallama" target="_blank">loveallama</a></li>
          <li><a href="https://github.com/fire219" target="_blank">Matthew&nbsp;Petry</a></li>
          <li>
            <a href="https://www.linkedin.com/in/matthew-rose-5bb819128/" target="_blank">
              Matthew&nbsp;Rose
            </a>
          </li>
          <li><a href="https://x.com/signseivr" target="_blank">Signsei</a></li>
          <li><a href="https://www.twitch.tv/zombi3doll" target="_blank">Zombi3Doll</a></li>
          <li>
            <a href="https://flirtual.com/about" target="_blank">The&nbsp;Flirtual&nbsp;Team</a>
          </li>
        </ul>
      </div>

      <div id="credits">
        <h2>credits</h2>
        <ul>
          <li>
            <a href="https://github.com/jdan/98.css" target="_blank">98.css</a>
            - Jordan&nbsp;Scales, based on Microsoft's Windows&nbsp;98
          </li>
          <li>
            <a href="https://github.com/captbaritone/webamp" target="_blank">Webamp</a>
            - Jordan&nbsp;Eldredge, based on Nullsoft's Winamp
          </li>
          <li>
            <a
              href="https://github.com/plan9foundation/plan9/blob/main/sys/src/games/catclock.c"
              target="_blank"
            >
              catclock.c
            </a>
            - Plan&nbsp;9 from Bell&nbsp;Labs based on California Clock Company's Kit-Cat&nbsp;Klock
          </li>
          <li>
            <a href="https://github.com/bryanbraun/after-dark-css" target="_blank">
              after-dark-css
            </a>
            - Bryan&nbsp;Braun, based on Berkeley&nbsp;Systems' After&nbsp;Dark
          </li>
          <li>
            <a href="https://emoji.serenityos.org" target="_blank">SerenityOS emoji</a>
            - the SerenityOS developers
          </li>
          <li>explode2.gif - Mark&nbsp;Overmars' Game&nbsp;Maker</li>
        </ul>

        <h2>themes</h2>
        <ul>
          <li>
            <a href="https://github.com/botoxparty/XP.css" target="_blank">XP.css</a>
            - Adam&nbsp;Hammad, based on Microsoft's Windows&nbsp;XP
          </li>
          <li>
            <a href="https://github.com/khang-nd/7.css" target="_blank">7.css</a>
            - Khang&nbsp;Nguyen&nbsp;Duy, based on Microsoft's Windows&nbsp;7
          </li>
          <li>
            <a href="https://github.com/sakofchit/system.css" target="_blank">system.css</a>
            - Sakun&nbsp;Acharige, based on Apple's System&nbsp;6
          </li>
          <li>
            <a href="https://github.com/npjg/classic.css" target="_blank">classic.css</a>
            - Nathanael&nbsp;Gentry, based on Apple's Mac&nbsp;OS&nbsp;8.1
          </li>
          <li>
            <a href="https://github.com/ktkk/motif-css" target="_blank">motif-css</a>
            - ktkk, based on OSF's Motif
          </li>
          <li>
            <a href="https://github.com/ekmas/cs16.css" target="_blank">cs16.css</a>
            - Samuel&nbsp;Breznjak, based on Valve's Counter-Strike&nbsp;1.6
          </li>
        </ul>

        <h2>winamp skins</h2>
        <ul>
          <li>Winamp&nbsp;XP Lookalike - +L0+</li>
          <li>
            Winamp5 Classified - Sven&nbsp;Kistner, Zarko&nbsp;Jovic, GuidoD
            and Wildrose-Wally
          </li>
          <li>MacOS8Amp - Gertjan&nbsp;van&nbsp;der&nbsp;Veldt</li>
          <li>classic_mac, solaris-CDE, SteamAmp - Unknown</li>
        </ul>

        <h2>avatar</h2>
        <ul>
          <li>
            <a href="https://booth.pm/en/items/3470989" target="_blank">Karin</a> - あまとうさぎ
          </li>
          <li>
            <a href="https://booth.pm/en/items/4654083" target="_blank">Skeleton for Karin カリン</a>
            - melting
          </li>
          <li>
            <a href="https://booth.pm/en/items/4186872" target="_blank">
              Double&nbsp;up&nbsp;Hair
            </a>
            - ANKA
          </li>
          <li>
            <a href="https://booth.pm/en/items/3888033" target="_blank">GothicPunk</a> - Pini
          </li>
          <li>
            <a href="https://booth.pm/en/items/5154750" target="_blank">
              DD&nbsp;Little&nbsp;Devil
            </a>
            - DD&nbsp;closet
          </li>
          <li>
            Brought to the web using <a href="https://github.com/mrdoob/three.js" target="_blank">three.js</a>, <a
              href="https://github.com/google/draco"
              target="_blank"
            >Draco</a>,
            <a href="https://github.com/zeux/meshoptimizer" target="_blank">meshoptimizer</a>
          </li>
        </ul>
      </div>

      <div id="music">
        <h2>music</h2>
        <iframe
          id="applemusic"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          frameborder="0"
          height="450"
          style="width:100%;overflow:hidden;"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          src="https://embed.music.apple.com/ca/playlist/pl.u-38oWZlWtPXjj6GZ?theme=light"
        >
        </iframe>
      </div>

      <h2 id="the-end">the end</h2>
      <p>thank you for visiting kfarwell.org have a nice day</p>

      <hr />
      <footer>
        <a href="https://internetometer.com/give/47641">
          <img
            src="https://internetometer.com/image/47641.png"
            alt="Give me an internet"
            width="256"
            height="96"
          />
        </a>
        <!-- The dock and the 88x31s move in here on mobile. -->
        <br id="footer-break" />
        <button id="toggle" onclick="toggleMode()">
          <span class="dock-icon">🌚</span>
          <span class="dock-label">Dark Mode</span>
        </button>
        <button id="themes-app" aria-label="Appearance">
          <span class="dock-icon">🎨</span>
          <span class="dock-label">Appearance</span>
        </button>
      </footer>
    </div>
  </div>

  <div class="window" id="testimonials-window" hidden>
    <div class="title-bar">
      <div class="title-bar-text">testimonials.txt</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body"></div>
  </div>

  <div class="window" id="friends-window" hidden>
    <div class="title-bar">
      <div class="title-bar-text">friends.txt</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body"></div>
  </div>

  <div class="window" id="credits-window" hidden>
    <div class="title-bar">
      <div class="title-bar-text">credits.txt</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body"></div>
  </div>

  <div class="window" id="catclock-window" hidden>
    <div class="title-bar">
      <div class="title-bar-text">CatClock</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body">
      <canvas id="catclock"></canvas>
    </div>
  </div>

  <Layouts.themes_window />

  <div class="window" id="chat-window" hidden>
    <div class="title-bar">
      <div class="title-bar-text">Chat - kfarwell</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>
    <div class="window-body">
      {live_render(@conn, KfarwellWeb.ChatLive, id: "chat")}
    </div>
  </div>

  <div id="webamp-host"></div>
</div>

<div id="icons">
  <button class="icon app" data-opens="chat-window">
    <span class="icon-image">
      <Layouts.icon_image kind="chat" />
    </span>
    <span class="icon-label">Chat</span>
  </button>
  <button class="icon app" data-launch="webamp">
    <span class="icon-image">
      <img src={~p"/webamp-icon.png"} alt="" draggable="false" />
    </span>
    <span class="icon-label">WebAmp</span>
  </button>
  <button class="icon app" data-opens="catclock-window">
    <span class="icon-image">
      <img src={~p"/catclock/catclock-icon.png"} alt="" draggable="false" />
    </span>
    <span class="icon-label">CatClock</span>
  </button>
  <button class="icon" data-opens="friends-window">
    <span class="icon-image">
      <Layouts.icon_image kind="document" />
    </span>
    <span class="icon-label">friends.txt</span>
  </button>
  <button class="icon" data-opens="testimonials-window">
    <span class="icon-image">
      <Layouts.icon_image kind="document" />
    </span>
    <span class="icon-label">testimonials.txt</span>
  </button>
  <button class="icon" id="credits-icon" data-opens="credits-window">
    <span class="icon-image">
      <Layouts.icon_image kind="document" />
    </span>
    <span class="icon-label">credits.txt</span>
  </button>
</div>

<div id="dock">
  <button id="kyle-app" aria-label="kfarwell" hidden>
    <img src={~p"/kyle.png"} alt="" width="128" height="128" />
  </button>
</div>

<a id="tamanotchi" href="https://tamanotchi.world/1595c" target="_blank" rel="noopener">
  <img src="https://tamanotchi.world/i2/1595" alt="Feed my tamaNOTchi" width="77" height="96" />
  <span class="dock-label">TamaNOTchi</span>
</a>

