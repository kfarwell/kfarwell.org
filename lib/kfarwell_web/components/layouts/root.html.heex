<!DOCTYPE html>
<html lang="en" data-theme="98">
  <head>
    <title>Kyle Farwell</title>
    <meta
      name="description"
      content="Lead developer of Flirtual. Trying to bring the world closer together with the power of love and VR!"
    />
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="stylesheet" href="/98.css" />
    <link rel="stylesheet" href="/toasters/toasters.css" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/webamp/webamp.css" />
    <link rel="stylesheet" href="/karin.css" />
    <link rel="stylesheet" href="/themes.css" />
    <link
      rel="stylesheet"
      href="https://linusg.github.io/serenityos-emoji-font/SerenityOS-Emoji.css"
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script src="/themes.js">
    </script>
    <script>
      const createElement = Document.prototype.createElement;
      Document.prototype.createElement = function (tag, ...rest) {
          const el = createElement.call(this, tag, ...rest);
          if (String(tag).toLowerCase() === "audio") {
              el.crossOrigin = "anonymous";
          }
          return el;
      };
    </script>
  </head>
  <body>
    {@inner_content}
    <script src="/script.js">
    </script>
    <script src="/toasters/toasters.js">
    </script>
    <script src="/catclock/catclock.js">
    </script>
    <script type="module" src="/webamp/webamp.js">
    </script>
    <script src="/karin.js">
    </script>
  </body>
</html>
